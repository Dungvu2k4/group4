import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Locale;
import java.util.Scanner;

public class CarList extends ArrayList<Car> {

    private final BrandList brandList;
    private final Scanner sc = new Scanner(System.in).useLocale(Locale.US);

    public CarList(BrandList bList) {
        super();
        this.brandList = bList;
    }

    // Helpers
    private String readNonBlank(String msg) {
        String s;
        do {
            System.out.print(msg);
            s = sc.nextLine().trim();
            if (s.isEmpty()) System.out.println("Không được để trống!");
        } while (s.isEmpty());
        return s;
    }

    private String readPattern(String msg, String regex, String hint) {
        String s;
        do {
            System.out.print(msg);
            s = sc.nextLine().trim();
            if (!s.matches(regex)) {
                System.out.println("Sai định dạng! " + hint);
                s = "";
            }
        } while (s.isEmpty());
        return s;
    }

    public boolean loadFromFile(String filename) {
        try {
            File f = new File(filename);
            if (!f.exists()) {
                System.out.println("File " + filename + " không tồn tại! (bỏ qua cars)");
                return false;
            }
            try (BufferedReader br = new BufferedReader(new FileReader(f))) {
                String line;
                while ((line = br.readLine()) != null) {
                    line = line.trim();
                    if (line.isEmpty()) continue;
                    // Định dạng: ID, brandID, color, frameID, engineID
                    String[] parts = line.split(",");
                    if (parts.length < 5) continue;

                    String carID = parts[0].trim();
                    String brandID = parts[1].trim();
                    String color = parts[2].trim();
                    String frameID = parts[3].trim();
                    String engineID = parts[4].trim();

                    int pos = brandList.searchID(brandID);
                    if (pos < 0) continue; // brand không tồn tại -> bỏ qua dòng lỗi
                    Brand b = brandList.get(pos);

                    this.add(new Car(carID, b, color, frameID, engineID));
                }
            }
            return true;
        } catch (Exception e) {
            System.out.println("Lỗi đọc file cars: " + e.getMessage());
            return false;
        }
    }

    public boolean saveToFile(String filename) {
        try (BufferedWriter bw = new BufferedWriter(new FileWriter(filename))) {
            for (Car c : this) {
                bw.write(c.toString());
                bw.newLine();
            }
            System.out.println("Đã lưu cars vào file: " + filename);
            return true;
        } catch (Exception e) {
            System.out.println("Lỗi ghi file cars: " + e.getMessage());
            return false;
        }
    }

    public int searchID(String ID) {
        for (int i = 0; i < this.size(); i++) {
            if (this.get(i).getCarID().equalsIgnoreCase(ID)) return i;
        }
        return -1;
    }

    public int searchFrame(String fID) {
        for (int i = 0; i < this.size(); i++) {
            if (this.get(i).getFrameID().equalsIgnoreCase(fID)) return i;
        }
        return -1;
    }

    public int searchEngine(String eID) {
        for (int i = 0; i < this.size(); i++) {
            if (this.get(i).getEngineID().equalsIgnoreCase(eID)) return i;
        }
        return -1;
    }

    public void addCar() {
        String carID;
        do {
            carID = readNonBlank("Nhập Car ID: ");
            if (searchID(carID) >= 0) {
                System.out.println("Car ID đã tồn tại, nhập lại!");
                carID = null;
            }
        } while (carID == null);

        // Chọn brand từ menu
        Menu m = new Menu();
        System.out.println("Chọn Brand:");
        Brand b = (Brand) m.ref_getChoice(brandList);
        if (b == null) {
            System.out.println("Hủy thao tác.");
            return;
        }

        String color = readNonBlank("Nhập màu (color): ");

        String frameID;
        do {
            frameID = readPattern("Nhập Frame ID (F00000): ", "F\\d{5}", "Ví dụ: F12345");
            if (searchFrame(frameID) >= 0) {
                System.out.println("Frame ID bị trùng, nhập lại!");
                frameID = null;
            }
        } while (frameID == null);

        String engineID;
        do {
            engineID = readPattern("Nhập Engine ID (E00000): ", "E\\d{5}", "Ví dụ: E12345");
            if (searchEngine(engineID) >= 0) {
                System.out.println("Engine ID bị trùng, nhập lại!");
                engineID = null;
            }
        } while (engineID == null);

        this.add(new Car(carID, b, color, frameID, engineID));
        System.out.println("Đã thêm car!");
    }

    public void printBasedBrandName() {
        String key = readNonBlank("Nhập một phần tên brand để tìm: ");
        int count = 0;
        for (Car c : this) {
            if (c.getBrand().getBrandName().toLowerCase().contains(key.toLowerCase())) {
                System.out.println(c.screenString());
                count++;
            }
        }
        if (count == 0) System.out.println("No car is detected!");
    }

    public boolean removeCar() {
        String id = readNonBlank("Nhập Car ID cần xóa: ");
        int pos = searchID(id);
        if (pos < 0) {
            System.out.println("Not found!");
            return false;
        }
        this.remove(pos);
        System.out.println("Đã xóa car!");
        return true;
    }

    public boolean updateCar() {
        String id = readNonBlank("Nhập Car ID cần cập nhật: ");
        int pos = searchID(id);
        if (pos < 0) {
            System.out.println("Not found!");
            return false;
        }

        // Chọn brand từ menu
        Menu m = new Menu();
        System.out.println("Chọn Brand mới:");
        Brand b = (Brand) m.ref_getChoice(brandList);
        if (b == null) {
            System.out.println("Hủy thao tác.");
            return false;
        }

        String color = readNonBlank("Nhập màu mới: ");

        String frameID;
        do {
            frameID = readPattern("Nhập Frame ID mới (F00000): ", "F\\d{5}", "Ví dụ: F99999");
            // cho phép dùng lại frameID cũ của chính nó
            int dup = searchFrame(frameID);
            if (dup >= 0 && dup != pos) {
                System.out.println("Frame ID bị trùng, nhập lại!");
                frameID = null;
            }
        } while (frameID == null);

        String engineID;
        do {
            engineID = readPattern("Nhập Engine ID mới (E00000): ", "E\\d{5}", "Ví dụ: E99999");
            int dup = searchEngine(engineID);
            if (dup >= 0 && dup != pos) {
                System.out.println("Engine ID bị trùng, nhập lại!");
                engineID = null;
            }
        } while (engineID == null);

        Car c = this.get(pos);
        c.setBrand(b);
        c.setColor(color);
        c.setFrameID(frameID);
        c.setEngineID(engineID);
        System.out.println("Đã cập nhật car!");
        return true;
    }

    public void listCars() {
        if (this.isEmpty()) {
            System.out.println("Danh sách car trống!");
            return;
        }
        Collections.sort(this);
        for (Car c : this) {
            System.out.println(c.screenString());
        }
    }
}

